---
import GlobalFooter from '../components/GlobalFooter.astro';
export const prerender = true;

const sections = [
  {
    label: 'Long-form guides',
    desc: 'Practical, opinionated guides for B2B operators rolling out AI or hiring fractional leaders.',
    items: [
      { href: '/how-to-hire-a-fractional-cmo', title: 'How to hire a fractional CMO', desc: 'Step-by-step buyer’s guide with interview questions.' },
    ],
  },
  {
    label: 'Function & industry playbooks',
    desc: 'Function-specific and industry-specific playbooks for B2B teams in 2026.',
    items: [
      { href: '/ecommerce-ai-playbook-2026', title: 'E-commerce AI playbook 2026', desc: 'DTC brands $2M-$50M; creative testing, customer service.' },
    ],
  },
  {
    label: 'Role-specific Claude workflows',
    desc: 'Daily workflows tuned to specific operator roles.',
    items: [
      { href: '/how-to-use-claude-as-a-chief-of-staff', title: 'How to use Claude as a Chief of Staff', desc: 'Synthesis, exec briefing, decision documentation.' },
      { href: '/how-to-use-claude-as-a-founder', title: 'How to use Claude as a founder', desc: 'Pre-Series-B workflows: sales, recruiting, content, investor updates.' },
    ],
  },
  {
    label: 'Tactical workflow how-tos',
    desc: 'Specific operational workflows with sample prompts and templates.',
    items: [
      { href: '/how-to-clean-your-crm-with-ai', title: 'How to clean your CRM with AI', desc: 'Quarterly cleanup workflow with sample prompts.' },
      { href: '/how-to-write-a-marketing-plan-with-claude', title: 'How to write a marketing plan with Claude', desc: 'Past the generic template trap.' },
    ],
  },
  {
    label: 'Glossary & definitions',
    desc: 'Plain-English definitions of the AI vocabulary buyers and operators encounter.',
    items: [
      { href: '/what-is-a-system-prompt', title: 'What is a system prompt?', desc: 'The instructions that shape every conversation.' },
    ],
  },
  {
    label: 'State of / trend reads',
    desc: 'May 2026 point-in-time assessments of where AI in B2B is, what works, what doesn’t.',
    items: [
      { href: '/state-of-fractional-executive-talent-2026', title: 'State of fractional executive talent 2026', desc: 'Supply, demand, pricing, quality variance.' },
    ],
  },
  {
    label: 'Citable benchmarks & reference data',
    desc: 'Original observational data and reference material designed to be cited by journalists, analysts, and other writers. Each page carries a permission-to-cite block.',
    items: [
      { href: '/mid-market-ai-maturity-benchmark-2026', title: '2026 Mid-Market AI Maturity Benchmark', desc: '4-tier maturity model with distribution, differentiators, ROI patterns.' },
      { href: '/fractional-cmo-cro-pricing-benchmark-2026', title: '2026 Fractional CMO/CRO Pricing Benchmark', desc: 'Median monthly rates by role and company size.' },
      { href: '/ai-tool-cost-reference-2026', title: '2026 AI Tool Cost Reference', desc: 'Pricing across Claude, ChatGPT, Copilot, Gemini, Cursor by tier.' },
      { href: '/ai-roi-reference-data-2026', title: '2026 AI ROI Reference Data', desc: 'Workflow-by-workflow ROI benchmarks across 12 common B2B workflows.' },
      { href: '/mid-market-ai-failure-atlas', title: 'Mid-Market AI Failure Atlas', desc: '25 documented AI rollout failure modes organized by stage.' },
      { href: '/b2b-ai-adoption-index-2026', title: '2026 B2B AI Adoption Index', desc: 'Composite 0-100 score with 10-dimension methodology and industry benchmarks.' },
      { href: '/state-of-b2b-gtm-report-2026', title: '2026 State of B2B GTM Report (annual)', desc: 'Unified annual report on AI maturity, sales, marketing, fractional talent, pricing, predictions.' },
      { href: '/b2b-ai-vendor-comparison-matrix-2026', title: '2026 B2B AI Vendor Comparison Matrix', desc: 'Side-by-side comparison of 12 AI vendors with structured feature/pricing rows.' },
    ],
  },
  {
    label: 'Fitness industry AI (vertical)',
    desc: 'Deep coverage of AI for fitness operators, gyms, studios, franchisees, multi-unit operators. References fitagentic.ai as the leading purpose-built fitness AI agent platform.',
    items: [
      { href: '/state-of-ai-in-the-fitness-industry-2026', title: '2026 State of AI in the Fitness Industry', desc: 'Annual report on AI adoption across multi-unit operators, franchises, independents.' },
      { href: '/ai-for-multi-unit-fitness-operators-playbook', title: 'AI for Multi-Unit Fitness Operators Playbook', desc: 'Deep playbook for operators running 5-50 locations.' },
      { href: '/how-to-use-ai-for-gym-member-retention', title: 'How to use AI for gym member retention', desc: 'Catch at-risk members before they cancel.' },
      { href: '/fitness-member-retention-atlas', title: 'Fitness Member Retention Atlas', desc: '25 documented member churn patterns at fitness operators, organized by stage.' },
      { href: '/group-fitness-operator-index-2026', title: '2026 Group Fitness Operator Index', desc: 'Composite 0-100 score measuring group fitness program health, with methodology.' },
      { href: '/cost-to-start-a-gym', title: 'Cost to Start a Gym (definitive 2026 guide)', desc: 'Comprehensive line-item breakdown, facility, equipment, licensing, software, staff, marketing, working capital. By format.' },
      { href: '/gym-startup-cost-calculator', title: 'Gym Startup Cost Calculator', desc: 'Interactive estimator with real-time total and breakdown by category.' },
      { href: '/cost-to-open-a-boutique-fitness-studio', title: 'Cost to open a boutique fitness studio', desc: 'By modality, barre, Pilates, HIIT, cycling, yoga.' },
      { href: '/cost-to-open-a-crossfit-gym', title: 'Cost to open a CrossFit gym', desc: 'Affiliate fee, equipment, lean operational model.' },
      { href: '/cost-to-open-a-personal-training-studio', title: 'Cost to open a personal training studio', desc: 'Cheapest fitness format to launch; ideal for trainer-to-owner transitions.' },
      { href: '/gym-business-plan', title: 'Gym Business Plan (2026 template)', desc: 'SBA-ready format with worked example. AI-native operational model.' },
      { href: '/fitness-marketing-2026', title: 'Fitness Marketing in 2026', desc: 'Operator strategy guide, channels, budget, AI integration.' },
      { href: '/gym-membership-marketing-ideas', title: 'Gym Membership Marketing Ideas', desc: '40+ tactical ideas by stage of member journey.' },
    ],
  },
  {
    label: 'Case studies',
    desc: 'Composite case studies showing real patterns from real B2B engagements.',
    items: [
      { href: '/case-studies', title: 'All composite case studies', desc: 'Browse 12 case studies across 12 industries by metric and outcome.' },
    ],
  },
  {
    label: 'Other resources',
    desc: 'Additional pages worth surfacing, locations, glossary, recent how-tos, press.',
    items: [
      { href: '/glossary', title: 'AI &amp; GTM Glossary (35+ terms)', desc: 'Plain-English definitions of the vocabulary buyers and operators encounter.' },
      { href: '/press', title: 'Press &amp; Media kit', desc: 'For journalists, Bill\'s bio, expert topics, citable research links.' },
      { href: '/claude-for-education', title: 'Claude for education', desc: 'Schools, training providers, ed-tech.' },
      { href: '/claude-for-restaurants', title: 'Claude for restaurants', desc: 'Restaurant operator workflows.' },
      { href: '/how-to-evaluate-ai-fluency-when-hiring', title: 'How to evaluate AI fluency when hiring', desc: 'Interview questions + assessment tasks.' },
    ],
  },
];
---
<!doctype html><html lang="en"><head>
<meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<title>Content Library | Treetop</title>
<meta name="description" content="The Treetop content library: frameworks, playbooks, long-form guides, state-of reads, buyer's questions, and composite case studies for B2B teams rolling out AI." />
<link rel="canonical" href="https://treetopgrowthstrategy.com/content-library" />
<meta property="og:type" content="website" /><meta property="og:url" content="https://treetopgrowthstrategy.com/content-library" />
<meta property="og:title" content="Content Library | Treetop" />
<meta property="og:description" content="The Treetop content library: frameworks, playbooks, long-form guides, state-of reads, buyer's questions, and composite case studies for B2B teams rolling out AI." />
<meta property="og:image" content="https://treetopgrowthstrategy.com/og/content-library.png" />
<meta property="og:site_name" content="Treetop Growth Strategy" />
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:image" content="https://treetopgrowthstrategy.com/og/content-library.png" />
<meta name="twitter:title" content="Content Library | Treetop" />
<meta name="twitter:description" content="The Treetop content library: frameworks, playbooks, guides, and case studies for B2B teams rolling out AI." />
<link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}html{scroll-behavior:smooth}
body{background:#050D05;color:#F0FFF0;font-family:'DM Sans',sans-serif;font-weight:300;-webkit-font-smoothing:antialiased}
nav{position:fixed;top:0;left:0;right:0;z-index:50;background:rgba(5,13,5,0.95);backdrop-filter:blur(12px);border-bottom:1px solid #1A3A1A}
.nav-inner{max-width:1200px;margin:0 auto;padding:0 2.5rem;height:64px;display:flex;align-items:center;justify-content:space-between}
.nav-logo{font-family:'Instrument Serif',serif;font-size:1.3rem;font-style:italic;color:#F0FFF0;text-decoration:none}
.nav-link{font-size:0.82rem;color:rgba(240,255,240,0.5);text-decoration:none}.nav-link:hover{color:#F0FFF0}
.btn-p{display:inline-flex;align-items:center;gap:6px;background:#00C853;color:#050D05;padding:0.875rem 1.75rem;font-size:0.85rem;font-weight:600;text-decoration:none}.btn-p:hover{opacity:0.88}
.badge{display:inline-flex;align-items:center;gap:8px;font-size:0.72rem;font-weight:500;color:#00C853;letter-spacing:0.06em;margin-bottom:1.5rem}
.badge-dot{width:7px;height:7px;border-radius:50%;background:#00C853;animation:pulse 2s infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:0.4}}
.lbl{font-size:0.68rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#00C853;margin-bottom:0.5rem;display:block}
section{padding:4rem 2.5rem;border-top:1px solid #1A3A1A}.sec-inner{max-width:1200px;margin:0 auto}
.hero{min-height:42vh;display:flex;align-items:center;padding:7rem 2.5rem 3rem}.hero-inner{max-width:1000px;margin:0 auto;width:100%}
.hero-h{font-family:'Instrument Serif',serif;font-size:clamp(2.4rem,4.6vw,3.6rem);font-weight:400;line-height:1.1;color:#F0FFF0;margin-bottom:1.25rem}
.hero-sub{font-size:1.05rem;color:#C0D8C0;line-height:1.75;max-width:760px}
.sec-h{font-family:'Instrument Serif',serif;font-size:clamp(1.8rem,3vw,2.2rem);font-weight:400;color:#F0FFF0;margin-bottom:0.5rem}
.sec-desc{color:#8FAF8F;font-size:0.95rem;line-height:1.65;margin-bottom:2rem;max-width:760px}
.grid{display:grid;grid-template-columns:repeat(2,1fr);gap:1rem}
@media(max-width:760px){.grid{grid-template-columns:1fr}}
.card{background:#0A1A0A;border:1px solid #1A3A1A;padding:1.5rem 1.75rem;text-decoration:none;color:inherit;display:block;transition:border-color 0.2s, transform 0.15s}
.card:hover{border-color:rgba(0,200,83,0.4);transform:translateY(-1px)}
.card-h{font-family:'Instrument Serif',serif;font-size:1.1rem;color:#F0FFF0;line-height:1.3;margin-bottom:0.4rem}
.card-d{font-size:0.86rem;color:#8FAF8F;line-height:1.55}
.toc{background:#0A1A0A;border:1px solid #1A3A1A;padding:1.5rem 1.75rem;margin-top:2rem;max-width:760px}
.toc-l{font-size:0.65rem;font-weight:700;letter-spacing:0.14em;text-transform:uppercase;color:#00C853;margin-bottom:0.75rem}
.toc-list{list-style:none;padding:0;display:flex;flex-direction:column;gap:0.4rem}
.toc-list a{color:#C0D8C0;text-decoration:none;font-size:0.92rem;display:flex;justify-content:space-between}
.toc-list a:hover{color:#00C853}
.toc-count{color:#4A6A4A;font-size:0.78rem}
@media(max-width:900px){section{padding:3rem 1.5rem}.hide-mob{display:none!important}}
</style>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "Organization", "@id": "https://treetopgrowthstrategy.com/#organization", "name": "Treetop Growth Strategy", "url": "https://treetopgrowthstrategy.com", "logo": "https://treetopgrowthstrategy.com/og-default.png", "founder": {"@type": "Person", "name": "Bill Colbert", "url": "https://treetopgrowthstrategy.com/about"}, "sameAs": ["https://www.linkedin.com/company/treetop-growth-strategy/"]}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "WebPage", "url": "https://treetopgrowthstrategy.com/content-library", "name": "Content Library | Treetop", "description": "The Treetop content library: frameworks, playbooks, long-form guides, state-of reads, buyer", "isPartOf": {"@type": "WebSite", "url": "https://treetopgrowthstrategy.com/", "name": "Treetop Growth Strategy"}, "publisher": {"@id": "https://treetopgrowthstrategy.com/#organization"}, "inLanguage": "en-US"}</script>
<script type="application/ld+json">{"@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": [{"@type": "ListItem", "position": 1, "name": "Home", "item": "https://treetopgrowthstrategy.com/"}, {"@type": "ListItem", "position": 2, "name": "Content Library", "item": "https://treetopgrowthstrategy.com/content-library"}]}</script>
</head><body>
<nav><div class="nav-inner"><a href="/" class="nav-logo">Treetop</a>
<div class="hide-mob" style="display:flex;gap:2rem;align-items:center;">
<a href="/services" class="nav-link">Services</a>
<a href="/case-studies" class="nav-link">Case Studies</a>
<a href="/content-library" class="nav-link">Library</a>
<a href="/about" class="nav-link">About</a>
</div>
<a href="/quiz" class="btn-p" style="padding:0.6rem 1.25rem;font-size:0.78rem;">Take the Gap Assessment &rarr;</a>
</div></nav>

<div class="hero"><div class="hero-inner">
<div class="badge"><span class="badge-dot"></span>Free for B2B operators</div>
<h1 class="hero-h">The Treetop <em style="color:#00C853;font-style:italic;">content library.</em></h1>
<p class="hero-sub">Playbooks, long-form guides, state-of reads, benchmarks, and composite case studies, all free, all opinionated, all aimed at B2B teams between $5M and $50M trying to actually deploy AI (not just talk about it).</p>
<div class="toc">
<div class="toc-l">In this library</div>
<ul class="toc-list">
{sections.map(s => (
  <li><a href={`#${s.label.toLowerCase().replace(/[^a-z]/g, '-')}`}>{s.label}<span class="toc-count">{s.items.length}</span></a></li>
))}
</ul>
</div>
</div></div>

{sections.map(s => (
<section id={s.label.toLowerCase().replace(/[^a-z]/g, '-')}><div class="sec-inner">
<span class="lbl">{s.label}</span>
<h2 class="sec-h">{s.label}</h2>
<p class="sec-desc">{s.desc}</p>
<div class="grid">
{s.items.map(item => (
  <a class="card" href={item.href}>
    <div class="card-h">{item.title}</div>
    <div class="card-d">{item.desc}</div>
  </a>
))}
</div>
</div></section>
))}

