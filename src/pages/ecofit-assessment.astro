---
export const prerender = true;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Ecofit Facility OpEx Assessment</title>
  <meta name="description" content="Free 2-minute assessment. Find out how much OpEx your facility network could be recovering." />
  <meta name="robots" content="noindex" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Raleway:wght@600;700&family=Work+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
</head>
<body>

<!-- ─── ALL STYLES ──────────────────────────────────────────────────────────── -->
<style>
* { box-sizing: border-box; margin: 0; padding: 0; }
html, body { height: 100%; overflow: hidden; }
body {
  background: #14191f;
  color: #F2F3F8;
  font-family: 'Work Sans', sans-serif;
  -webkit-font-smoothing: antialiased;
}

/* progress */
#pb-wrap { position: fixed; top: 0; left: 0; right: 0; height: 3px; background: rgba(132,188,65,0.15); z-index: 500; }
#pb      { height: 3px; width: 0; background: #84BC41; transition: width 0.4s ease; }

/* nav */
#topnav {
  position: fixed; top: 3px; left: 0; right: 0; height: 60px; z-index: 400;
  display: flex; align-items: center; justify-content: space-between;
  padding: 0 40px;
  background: #14191f;
  border-bottom: 1px solid rgba(132,188,65,0.1);
}
#topnav img { height: 28px; }
#topnav-lbl { font-size: 11px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase; color: rgba(242,243,248,0.3); }

/* steps */
.s {
  position: fixed; top: 63px; left: 0; right: 0; bottom: 0;
  overflow-y: auto;
  display: flex; flex-direction: column; align-items: center;
  padding: 48px 24px 60px;
  transition: opacity 0.24s ease, transform 0.24s ease;
}
.s.off { opacity: 0; pointer-events: none; transform: translateY(14px); }
.s.out { opacity: 0; pointer-events: none; transform: translateY(-14px); }
.inner { width: 100%; max-width: 600px; }
.vcenter { display: flex; flex-direction: column; justify-content: center; min-height: calc(100vh - 180px); }

/* intro */
.eyebrow {
  font-size: 11px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase;
  color: #84BC41; margin-bottom: 20px;
  display: flex; align-items: center; gap: 10px;
}
.eyebrow::before { content: ''; width: 18px; height: 1px; background: #84BC41; }
.intro-h {
  font-family: 'Raleway', sans-serif; font-weight: 700;
  font-size: clamp(2rem, 5vw, 3rem); line-height: 1.1;
  letter-spacing: -0.015em; color: #F2F3F8; margin-bottom: 16px;
}
.intro-h em { color: #84BC41; font-style: normal; }
.intro-p { font-size: 16px; font-weight: 300; color: #9699A2; line-height: 1.8; margin-bottom: 32px; max-width: 500px; }

/* stats strip */
.stats { display: flex; border: 1px solid rgba(132,188,65,0.15); margin-bottom: 36px; }
.stat { flex: 1; padding: 16px 20px; border-right: 1px solid rgba(132,188,65,0.15); }
.stat:last-child { border-right: none; }
.stat-n { font-family: 'Raleway', sans-serif; font-weight: 700; font-size: 1.6rem; color: #84BC41; margin-bottom: 4px; }
.stat-l { font-size: 11px; color: rgba(242,243,248,0.36); line-height: 1.45; }

/* cta button */
.cta {
  display: inline-flex; align-items: center; gap: 8px;
  background: #84BC41; color: #14191f;
  font-family: 'Work Sans', sans-serif; font-size: 15px; font-weight: 600;
  border: none; padding: 14px 28px; border-radius: 3px; cursor: pointer;
  transition: background 0.15s, transform 0.12s; text-decoration: none;
  letter-spacing: 0.01em;
}
.cta:hover { background: #96d147; transform: translateY(-1px); }
.cta:active { transform: none; }
.cta:disabled { opacity: 0.4; cursor: not-allowed; transform: none; }
.cta-note { display: block; margin-top: 12px; font-size: 12px; color: rgba(242,243,248,0.28); }
.cta-ghost { background: transparent; color: #F2F3F8; border: 1px solid rgba(242,243,248,0.2); }
.cta-ghost:hover { border-color: rgba(132,188,65,0.5); color: #84BC41; background: transparent; }

/* question layout */
.q-meta { display: flex; align-items: center; gap: 10px; margin-bottom: 20px; }
.q-num { font-family: 'Raleway', sans-serif; font-weight: 700; font-size: 12px; color: #84BC41; letter-spacing: 0.08em; }
.q-sep { width: 1px; height: 12px; background: rgba(132,188,65,0.3); }
.q-cat { font-size: 10px; font-weight: 600; letter-spacing: 0.18em; text-transform: uppercase; color: rgba(242,243,248,0.28); }
.q-text {
  font-family: 'Raleway', sans-serif; font-weight: 700;
  font-size: clamp(1.3rem, 3vw, 1.85rem); line-height: 1.25;
  color: #F2F3F8; margin-bottom: 12px;
}
.q-hint {
  font-size: 13px; font-weight: 300; color: rgba(242,243,248,0.4);
  line-height: 1.65; padding-left: 12px;
  border-left: 2px solid rgba(132,188,65,0.25);
  margin-bottom: 28px;
}

/* option cards — the critical part */
.opts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;
  margin-bottom: 24px;
}
.opt {
  display: flex;
  align-items: flex-start;
  gap: 12px;
  padding: 14px 16px;
  background: #1c2329;
  border: 1.5px solid rgba(132,188,65,0.18);
  border-radius: 4px;
  cursor: pointer;
  text-align: left;
  font-family: 'Work Sans', sans-serif;
  font-size: 14px;
  font-weight: 400;
  line-height: 1.45;
  color: #c8cdd2;
  transition: border-color 0.13s, background 0.13s, color 0.13s;
  width: 100%;
}
.opt:hover { border-color: rgba(132,188,65,0.55); background: rgba(132,188,65,0.06); color: #F2F3F8; }
.opt.on    { border-color: #84BC41; background: rgba(132,188,65,0.1); color: #F2F3F8; }
.dot {
  width: 18px; height: 18px; flex-shrink: 0; margin-top: 1px;
  border: 1.5px solid rgba(132,188,65,0.4); border-radius: 50%;
  display: flex; align-items: center; justify-content: center;
  transition: all 0.13s;
}
.opt.on .dot { background: #84BC41; border-color: #84BC41; }
.opt.on .dot::after { content: ''; width: 6px; height: 6px; background: #14191f; border-radius: 50%; }

/* back */
.back {
  background: none; border: none; cursor: pointer;
  font-family: 'Work Sans', sans-serif; font-size: 13px;
  color: rgba(242,243,248,0.28); padding: 0;
  display: inline-flex; align-items: center; gap: 4px;
  transition: color 0.13s;
}
.back:hover { color: rgba(242,243,248,0.55); }

/* risk reveal */
.risk-box {
  background: #1c2329;
  border: 1px solid rgba(132,188,65,0.22);
  border-left: 4px solid #84BC41;
  border-radius: 4px; padding: 24px 28px; margin-bottom: 24px;
}
.risk-lbl { font-size: 10px; font-weight: 600; letter-spacing: 0.16em; text-transform: uppercase; color: rgba(242,243,248,0.36); margin-bottom: 8px; }
.risk-amt { font-family: 'Raleway', sans-serif; font-weight: 700; font-size: clamp(2rem,6vw,3rem); color: #84BC41; display: block; margin-bottom: 6px; line-height: 1; }
.risk-sub { font-size: 13px; color: #9699A2; font-weight: 300; }

/* form */
.fg { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; margin-bottom: 10px; }
.ff { display: flex; flex-direction: column; gap: 5px; }
.ff.full { grid-column: 1 / -1; }
.fl { font-size: 10px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(242,243,248,0.36); }
.fi {
  background: #1c2329; border: 1.5px solid rgba(132,188,65,0.15);
  color: #F2F3F8; padding: 12px 14px;
  font-family: 'Work Sans', sans-serif; font-size: 15px; font-weight: 300;
  border-radius: 4px; outline: none; width: 100%;
  -webkit-appearance: none; transition: border-color 0.15s;
}
.fi:focus { border-color: #84BC41; }
.fi::placeholder { color: rgba(242,243,248,0.22); }
.fn { font-size: 12px; color: rgba(242,243,248,0.24); margin-top: 8px; line-height: 1.5; }
#sbtn { width: 100%; justify-content: center; margin-top: 14px; padding: 15px; font-size: 15px; }
#emsg { color: #f87171; font-size: 13px; margin-top: 8px; display: none; }

/* confirm */
.chk {
  width: 52px; height: 52px; border-radius: 50%;
  background: rgba(132,188,65,0.1); border: 1px solid rgba(132,188,65,0.5);
  display: flex; align-items: center; justify-content: center; margin-bottom: 22px;
}
.cfm-h { font-family: 'Raleway', sans-serif; font-weight: 700; font-size: clamp(1.6rem,4vw,2.2rem); color: #F2F3F8; margin-bottom: 12px; line-height: 1.15; }
.cfm-p { font-size: 15px; color: #9699A2; line-height: 1.8; margin-bottom: 26px; max-width: 460px; font-weight: 300; }
.cfm-stats { display: flex; border: 1px solid rgba(132,188,65,0.15); margin-bottom: 28px; }
.cfm-stat { flex: 1; padding: 16px 20px; border-right: 1px solid rgba(132,188,65,0.15); }
.cfm-stat:last-child { border-right: none; }
.cfm-stat-l { font-size: 10px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(242,243,248,0.3); margin-bottom: 6px; }
.cfm-stat-v { font-family: 'Raleway', sans-serif; font-weight: 700; font-size: 1.3rem; color: #84BC41; }
.bl { margin-top: 20px; display: inline-flex; align-items: center; gap: 5px; font-size: 13px; color: rgba(242,243,248,0.22); text-decoration: none; transition: color 0.14s; }
.bl:hover { color: rgba(242,243,248,0.45); }

@media (max-width: 540px) {
  #topnav { padding: 0 18px; }
  .s { padding: 32px 16px 48px; }
  .opts { grid-template-columns: 1fr; }
  .fg   { grid-template-columns: 1fr; }
  .stats { flex-direction: column; }
  .stat { border-right: none; border-bottom: 1px solid rgba(132,188,65,0.15); }
  .stat:last-child { border-bottom: none; }
  .cfm-stats { flex-direction: column; }
  .cfm-stat { border-right: none; border-bottom: 1px solid rgba(132,188,65,0.15); }
  .cfm-stat:last-child { border-bottom: none; }
}
</style>

<!-- ─── CHROME ───────────────────────────────────────────────────────────────── -->
<div id="pb-wrap"><div id="pb"></div></div>

<div id="topnav">
  <img src="/assets/ecofit-logo-dark.png" alt="Ecofit"
       onerror="this.style.display='none';document.getElementById('logo-fb').style.display='block'">
  <span id="logo-fb" style="display:none;font-family:'Raleway',sans-serif;font-weight:700;font-size:20px;color:#84BC41">ecofit</span>
  <span id="topnav-lbl">Facility OpEx Assessment</span>
</div>

<!-- ─── INTRO ────────────────────────────────────────────────────────────────── -->
<div class="s" id="s0">
  <div class="inner">
    <div class="vcenter">
      <div class="eyebrow">Free · 2 Minutes · Personalized Report</div>
      <h1 class="intro-h">
        Could your facility be<br>
        <em>squandering $250K+</em><br>
        every year?
      </h1>
      <p class="intro-p">Multi-location fitness operators running without real equipment intelligence absorb enormous costs invisibly. Eight questions tells you exactly how much is at stake — and where to start.</p>
      <div class="stats">
        <div class="stat"><div class="stat-n">40%</div><div class="stat-l">Reduction in equipment refresh costs</div></div>
        <div class="stat"><div class="stat-n">3.2×</div><div class="stat-l">Longer equipment lifespan on average</div></div>
        <div class="stat"><div class="stat-n">200+</div><div class="stat-l">Assets networked per facility</div></div>
      </div>
      <div>
        <button class="cta" onclick="goTo('q0',0)">Calculate My OpEx Risk →</button>
        <span class="cta-note">No cost · Report delivered to your inbox</span>
      </div>
    </div>
  </div>
</div>

<!-- ─── Q1: LOCATIONS ────────────────────────────────────────────────────────── -->
<div class="s off" id="q0">
  <div class="inner">
    <div class="q-meta"><span class="q-num">01 / 08</span><span class="q-sep"></span><span class="q-cat">Your Network</span></div>
    <div class="q-text">How many locations do you currently operate?</div>
    <div class="q-hint">Include all active locations — owned, managed, or franchised.</div>
    <div class="opts">
      <button class="opt" onclick="pick('locations','1',0,this)"><span class="dot"></span><span>1 location</span></button>
      <button class="opt" onclick="pick('locations','2-5',0,this)"><span class="dot"></span><span>2–5 locations</span></button>
      <button class="opt" onclick="pick('locations','6-15',0,this)"><span class="dot"></span><span>6–15 locations</span></button>
      <button class="opt" onclick="pick('locations','16-50',0,this)"><span class="dot"></span><span>16–50 locations</span></button>
      <button class="opt" onclick="pick('locations','51-100',0,this)"><span class="dot"></span><span>51–100 locations</span></button>
      <button class="opt" onclick="pick('locations','100+',0,this)"><span class="dot"></span><span>100+ locations</span></button>
    </div>
  </div>
</div>

<!-- ─── Q2: EQUIPMENT ────────────────────────────────────────────────────────── -->
<div class="s off" id="q1">
  <div class="inner">
    <div class="q-meta"><span class="q-num">02 / 08</span><span class="q-sep"></span><span class="q-cat">Your Network</span></div>
    <div class="q-text">Roughly how many pieces of equipment does your average location run?</div>
    <div class="q-hint">Count everything — cardio, strength, functional, specialty. Estimate is fine.</div>
    <div class="opts">
      <button class="opt" onclick="pick('equipment','under-30',1,this)"><span class="dot"></span><span>Under 30 pieces</span></button>
      <button class="opt" onclick="pick('equipment','30-75',1,this)"><span class="dot"></span><span>30–75 pieces</span></button>
      <button class="opt" onclick="pick('equipment','76-150',1,this)"><span class="dot"></span><span>76–150 pieces</span></button>
      <button class="opt" onclick="pick('equipment','151-300',1,this)"><span class="dot"></span><span>151–300 pieces</span></button>
      <button class="opt" onclick="pick('equipment','300+',1,this)"><span class="dot"></span><span>300+ pieces</span></button>
    </div>
    <button class="back" onclick="goTo('q0',0)">← Back</button>
  </div>
</div>

<!-- ─── Q3: TRACKING ─────────────────────────────────────────────────────────── -->
<div class="s off" id="q2">
  <div class="inner">
    <div class="q-meta"><span class="q-num">03 / 08</span><span class="q-sep"></span><span class="q-cat">Current Operations</span></div>
    <div class="q-text">How are you currently tracking equipment performance and utilization?</div>
    <div class="q-hint">This is the single biggest driver of OpEx waste we see across operators.</div>
    <div class="opts">
      <button class="opt" onclick="pick('tracking','software',2,this)"><span class="dot"></span><span>Dedicated software or IoT-connected equipment</span></button>
      <button class="opt" onclick="pick('tracking','tickets',2,this)"><span class="dot"></span><span>Service tickets and staff reports</span></button>
      <button class="opt" onclick="pick('tracking','manual',2,this)"><span class="dot"></span><span>Periodic manual audits</span></button>
      <button class="opt" onclick="pick('tracking','none',2,this)"><span class="dot"></span><span>We don't have a formal system</span></button>
    </div>
    <button class="back" onclick="goTo('q1',1)">← Back</button>
  </div>
</div>

<!-- ─── Q4: MAINTENANCE ──────────────────────────────────────────────────────── -->
<div class="s off" id="q3">
  <div class="inner">
    <div class="q-meta"><span class="q-num">04 / 08</span><span class="q-sep"></span><span class="q-cat">Current Operations</span></div>
    <div class="q-text">How much of your maintenance spend last year was reactive — unplanned repairs after something broke?</div>
    <div class="q-hint">Industry benchmark: best-in-class operators keep reactive spend under 20%.</div>
    <div class="opts">
      <button class="opt" onclick="pick('maintenance','planned',3,this)"><span class="dot"></span><span>Mostly planned — under 25% reactive</span></button>
      <button class="opt" onclick="pick('maintenance','mixed',3,this)"><span class="dot"></span><span>Roughly half and half</span></button>
      <button class="opt" onclick="pick('maintenance','reactive',3,this)"><span class="dot"></span><span>Mostly reactive — over 50% unplanned</span></button>
      <button class="opt" onclick="pick('maintenance','unknown',3,this)"><span class="dot"></span><span>We don't track this breakdown</span></button>
    </div>
    <button class="back" onclick="goTo('q2',2)">← Back</button>
  </div>
</div>

<!-- ─── Q5: AGE ──────────────────────────────────────────────────────────────── -->
<div class="s off" id="q4">
  <div class="inner">
    <div class="q-meta"><span class="q-num">05 / 08</span><span class="q-sep"></span><span class="q-cat">Equipment Profile</span></div>
    <div class="q-text">What's the average age of your primary cardio and strength equipment?</div>
    <div class="q-hint">Older fleets without visibility data carry compounding capex risk.</div>
    <div class="opts">
      <button class="opt" onclick="pick('age','under-3',4,this)"><span class="dot"></span><span>Under 3 years — relatively new fleet</span></button>
      <button class="opt" onclick="pick('age','3-6',4,this)"><span class="dot"></span><span>3–6 years — starting to see more service calls</span></button>
      <button class="opt" onclick="pick('age','6-10',4,this)"><span class="dot"></span><span>6–10 years — significant maintenance pressure</span></button>
      <button class="opt" onclick="pick('age','10+',4,this)"><span class="dot"></span><span>10+ years — major replacement cycle coming</span></button>
    </div>
    <button class="back" onclick="goTo('q3',3)">← Back</button>
  </div>
</div>

<!-- ─── Q6: RECOVERY ─────────────────────────────────────────────────────────── -->
<div class="s off" id="q5">
  <div class="inner">
    <div class="q-meta"><span class="q-num">06 / 08</span><span class="q-sep"></span><span class="q-cat">Equipment Profile</span></div>
    <div class="q-text">Do you have a dedicated recovery or wellness zone at your locations?</div>
    <div class="q-hint">Recovery zones are the fastest-growing capex category in fitness — and the least measured.</div>
    <div class="opts">
      <button class="opt" onclick="pick('recovery','none',5,this)"><span class="dot"></span><span>No dedicated recovery area</span></button>
      <button class="opt" onclick="pick('recovery','small',5,this)"><span class="dot"></span><span>Small zone — under 500 sq ft</span></button>
      <button class="opt" onclick="pick('recovery','medium',5,this)"><span class="dot"></span><span>Medium zone — 500–1,500 sq ft</span></button>
      <button class="opt" onclick="pick('recovery','large',5,this)"><span class="dot"></span><span>Large or premium recovery area — 1,500+ sq ft</span></button>
    </div>
    <button class="back" onclick="goTo('q4',4)">← Back</button>
  </div>
</div>

<!-- ─── Q7: IMPACT ───────────────────────────────────────────────────────────── -->
<div class="s off" id="q6">
  <div class="inner">
    <div class="q-meta"><span class="q-num">07 / 08</span><span class="q-sep"></span><span class="q-cat">Member Experience</span></div>
    <div class="q-text">In the last 12 months, how often has equipment downtime visibly impacted member experience?</div>
    <div class="q-hint">Out-of-order equipment, member complaints, or staff scrambling to respond.</div>
    <div class="opts">
      <button class="opt" onclick="pick('impact','rarely',6,this)"><span class="dot"></span><span>Rarely — equipment is mostly reliable</span></button>
      <button class="opt" onclick="pick('impact','occasionally',6,this)"><span class="dot"></span><span>Occasionally — a few incidents per quarter</span></button>
      <button class="opt" onclick="pick('impact','frequently',6,this)"><span class="dot"></span><span>Frequently — members notice and sometimes complain</span></button>
      <button class="opt" onclick="pick('impact','known-pain',6,this)"><span class="dot"></span><span>It's a known pain point we haven't solved</span></button>
    </div>
    <button class="back" onclick="goTo('q5',5)">← Back</button>
  </div>
</div>

<!-- ─── Q8: DATA CONFIDENCE ──────────────────────────────────────────────────── -->
<div class="s off" id="q7">
  <div class="inner">
    <div class="q-meta"><span class="q-num">08 / 08</span><span class="q-sep"></span><span class="q-cat">Visibility & Analytics</span></div>
    <div class="q-text">How confident are you in the accuracy of your equipment ROI data right now?</div>
    <div class="q-hint">This is what Ecofit gives you. Most operators feel the gap as soon as they answer this.</div>
    <div class="opts">
      <button class="opt" onclick="pick('data_confidence','high',7,this)"><span class="dot"></span><span>Very confident — we have real-time visibility</span></button>
      <button class="opt" onclick="pick('data_confidence','medium',7,this)"><span class="dot"></span><span>Somewhat confident — we track it but it's incomplete</span></button>
      <button class="opt" onclick="pick('data_confidence','low',7,this)"><span class="dot"></span><span>Not very confident — our data has significant gaps</span></button>
      <button class="opt" onclick="pick('data_confidence','none',7,this)"><span class="dot"></span><span>We don't have equipment ROI data</span></button>
    </div>
    <button class="back" onclick="goTo('q6',6)">← Back</button>
  </div>
</div>

<!-- ─── LEAD CAPTURE ─────────────────────────────────────────────────────────── -->
<div class="s off" id="slead">
  <div class="inner">
    <div class="vcenter">
      <div class="risk-box">
        <div class="risk-lbl">Estimated Annual OpEx at Risk</div>
        <span class="risk-amt" id="risk-amt">—</span>
        <div class="risk-sub" id="risk-sub"></div>
      </div>
      <h2 style="font-family:'Raleway',sans-serif;font-weight:700;font-size:1.35rem;color:#F2F3F8;margin-bottom:8px;">Get your full Facility Intelligence Report.</h2>
      <p style="font-size:14px;color:#9699A2;line-height:1.75;font-weight:300;margin-bottom:20px;">Personalized breakdown by category, benchmarks against comparable operators, and three priority actions to close the gap.</p>
      <form id="lform">
        <div class="fg">
          <div class="ff"><label class="fl" for="fn">First Name *</label><input class="fi" type="text" id="fn" placeholder="Jordan" required></div>
          <div class="ff"><label class="fl" for="fc">Company *</label><input class="fi" type="text" id="fc" placeholder="Apex Fitness" required></div>
          <div class="ff full"><label class="fl" for="fe">Work Email *</label><input class="fi" type="email" id="fe" placeholder="jordan@apexfitness.com" required></div>
          <div class="ff"><label class="fl" for="ft">Title</label><input class="fi" type="text" id="ft" placeholder="VP Operations, CEO…"></div>
          <div class="ff"><label class="fl" for="fp">Phone</label><input class="fi" type="tel" id="fp" placeholder="(555) 000-0000"></div>
        </div>
        <p class="fn2">Report arrives within 5 minutes. We don't share your information.</p>
        <button class="cta" id="sbtn" type="submit">Send My Facility Report →</button>
        <div id="emsg">Something went wrong — please try again.</div>
      </form>
    </div>
  </div>
</div>

<!-- ─── CONFIRM ──────────────────────────────────────────────────────────────── -->
<div class="s off" id="sconfirm">
  <div class="inner">
    <div class="vcenter">
      <div class="chk">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#84BC41" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>
      </div>
      <div class="cfm-h">Your report is on its way.</div>
      <p class="cfm-p">Check your inbox in the next few minutes. Your Ecofit Facility Intelligence Report includes a full OpEx breakdown, benchmarks for your facility type, and three priority actions.</p>
      <div class="cfm-stats">
        <div class="cfm-stat"><div class="cfm-stat-l">Estimated at risk</div><div class="cfm-stat-v" id="crisk">—</div></div>
        <div class="cfm-stat"><div class="cfm-stat-l">Network size</div><div class="cfm-stat-v" id="cnet">—</div></div>
      </div>
      <p style="font-size:14px;color:#9699A2;line-height:1.8;margin-bottom:24px;max-width:440px;font-weight:300;">If you'd like to see what the intelligence layer looks like for your specific network, an analyst is available for a 30-minute no-commitment demo.</p>
      <a href="https://calendar.app.google/GS5H5y8U3PrN8u4A8" class="cta" target="_blank" rel="noopener">Book a Demo →</a>
      <a href="https://treetopgrowthstrategy.com" class="bl">← Back to Treetop Growth Strategy</a>
    </div>
  </div>
</div>

<!-- ─── SCRIPT ───────────────────────────────────────────────────────────────── -->
<script>
  var answers = {};
  var TOTAL = 8;

  function goTo(id, n) {
    document.querySelectorAll('.s').forEach(function(el) {
      if (!el.classList.contains('off')) {
        el.classList.add('out');
        setTimeout(function() { el.classList.add('off'); el.classList.remove('out'); }, 240);
      }
    });
    setTimeout(function() {
      var next = document.getElementById(id);
      if (next) { next.classList.remove('off'); next.scrollTop = 0; }
      document.getElementById('pb').style.width = Math.round((n / TOTAL) * 100) + '%';
    }, 150);
  }

  function pick(key, val, idx, el) {
    el.closest('.opts').querySelectorAll('.opt').forEach(function(o) { o.classList.remove('on'); });
    el.classList.add('on');
    answers[key] = val;
    setTimeout(function() {
      if (idx < TOTAL - 1) { goTo('q' + (idx + 1), idx + 1); }
      else { showLead(); }
    }, 320);
  }

  // ── SCORING ───────────────────────────────────────────────────────────────
  function score() {
    var lM = {'1':1,'2-5':3,'6-15':10,'16-50':30,'51-100':75,'100+':150};
    var eM = {'under-30':18,'30-75':50,'76-150':110,'151-300':220,'300+':350};
    var tM = {'software':0.55,'tickets':1.0,'manual':1.25,'none':1.5};
    var mM = {'planned':0.65,'mixed':1.0,'reactive':1.45,'unknown':1.25};
    var aR = {'under-3':0,'3-6':12000,'6-10':38000,'10+':75000};
    var rM = {'none':0,'small':10000,'medium':24000,'large':48000};
    var iM = {'rarely':0.85,'occasionally':1.0,'frequently':1.2,'known-pain':1.35};
    var dM = {'high':0.5,'medium':0.9,'low':1.2,'none':1.45};

    var l = lM[answers.locations] || 1;
    var e = eM[answers.equipment] || 18;
    var t = tM[answers.tracking]  || 1.0;
    var m = mM[answers.maintenance] || 1.0;
    var a = (aR[answers.age] || 0) * l;
    var r = (rM[answers.recovery] || 0) * l;
    var i = iM[answers.impact] || 1.0;
    var d = dM[answers.data_confidence] || 1.0;

    return Math.round((e * l * 2000 * t * m * i * d) + (a * m) + (r * d));
  }

  function fmt(n) {
    if (n >= 1000000) return '$' + (n/1000000).toFixed(1) + 'M';
    if (n >= 1000)    return '$' + Math.round(n/1000) + 'K';
    return '$' + n;
  }

  function netLabel() {
    return ({'1':'1 location','2-5':'2–5 locations','6-15':'6–15 locations','16-50':'16–50 locations','51-100':'51–100 locations','100+':'100+ locations'})[answers.locations] || 'your network';
  }

  function showLead() {
    var r  = score();
    var lo = fmt(Math.round(r * 0.75));
    var hi = fmt(Math.round(r * 1.35));
    var range = lo + '–' + hi;

    var lbl = r < 100000  ? 'Emerging exposure — targeted quick wins available'
            : r < 300000  ? 'Significant exposure — clear ROI opportunity at this scale'
            : r < 750000  ? 'High exposure — network-wide intelligence pays for itself fast'
            :               'Critical exposure — every quarter without visibility compounds the cost';

    document.getElementById('risk-amt').textContent = range;
    document.getElementById('risk-sub').textContent = lbl;
    window._range = range;
    goTo('slead', TOTAL);
  }

  // ── FORM ─────────────────────────────────────────────────────────────────
  document.getElementById('lform').addEventListener('submit', async function(e) {
    e.preventDefault();
    var btn = document.getElementById('sbtn');
    var err = document.getElementById('emsg');
    btn.disabled = true;
    btn.textContent = 'Generating your report…';
    err.style.display = 'none';

    var r = score();
    try {
      var res = await fetch('/api/ecofit-assessment-submit', {
        method: 'POST',
        headers: {'Content-Type':'application/json'},
        body: JSON.stringify({
          name:         document.getElementById('fn').value.trim(),
          email:        document.getElementById('fe').value.trim(),
          company:      document.getElementById('fc').value.trim(),
          title:        document.getElementById('ft').value.trim(),
          phone:        document.getElementById('fp').value.trim(),
          answers:      answers,
          riskLow:      Math.round(r * 0.75),
          riskHigh:     Math.round(r * 1.35),
          riskMid:      r,
          networkLabel: netLabel()
        })
      });
      if (!res.ok) throw 0;
      document.getElementById('crisk').textContent = window._range || (fmt(Math.round(r*0.75))+'–'+fmt(Math.round(r*1.35)));
      document.getElementById('cnet').textContent  = netLabel();
      goTo('sconfirm', TOTAL);
      document.getElementById('pb').style.width = '100%';
    } catch(_) {
      err.style.display = 'block';
      btn.disabled = false;
      btn.textContent = 'Send My Facility Report →';
    }
  });
</script>

<!-- fn2 needs to be styled via inline since it shares 'fn' id -->
<style>
  .fn2 { font-size: 12px; color: rgba(242,243,248,0.24); margin-top: 8px; line-height: 1.5; }
</style>

</body>
</html>
